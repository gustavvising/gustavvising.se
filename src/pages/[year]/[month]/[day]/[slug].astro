
---
import { render } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import { getPosts, postParts, postUrl, formatDate } from '../../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: postParts(post),
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, description, date, lang } = post.data;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  inLanguage: lang,
  author: { '@type': 'Person', name: 'Gustav Vising', url: 'https://www.linkedin.com/in/gustavvising/' },
};
---
<Base title={title} description={description} type="article" lang={lang} published={date}>
  <div id="progress" class="fixed inset-x-0 top-0 z-[55] h-[3px] origin-left scale-x-0 bg-accent"></div>

  <main class="px-5 pb-24 pt-32 sm:px-10 sm:pt-40">
    <article class="mx-auto max-w-[88rem]">

      <a href="/#artiklar" class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-mute transition-colors hover:text-ink">
        alla artiklar
      </a>

      <header class="mt-10 max-w-6xl border-b border-line pb-12">
        <p class="mb-6 font-mono text-[0.78rem] uppercase tracking-widest text-mute">
          {formatDate(date)}
        </p>

        <h1 class="font-display text-[clamp(1.6rem,5vw,4rem)] font-extrabold leading-[1.05] tracking-[-0.035em] [overflow-wrap:anywhere]">
          {title}
        </h1>
      </header>

      <div class="mt-14 grid grid-cols-[minmax(0,1fr)] gap-12 lg:grid-cols-[1fr_minmax(0,68ch)_1fr]">
        <div class="prose-gv min-w-0 lg:col-start-2">
          <Content />
        </div>
      </div>
      <nav class="mt-28 grid gap-4 border-t border-rule pt-10 sm:grid-cols-2" aria-label="Fler artiklar">
        {newer ? (
          <a href={postUrl(newer)} class="group rounded-xl border border-line bg-deep/70 p-6 transition-colors">
            <span class="font-mono text-xs uppercase tracking-widest text-mute">← nyare</span>
            <span class="mt-3 block font-display text-xl font-bold leading-tight">{newer.data.title}</span>
          </a>
        ) : <span />}

        {older ? (
          <a href={postUrl(older)} class="group rounded-xl border border-line bg-deep/70 p-6 text-left transition-colors sm:text-right">
            <span class="font-mono text-xs uppercase tracking-widest text-mute">äldre →</span>
            <span class="mt-3 block font-display text-xl font-bold leading-tight">{older.data.title}</span>
          </a>
        ) : <span />}
      </nav>

      <footer class="mt-20 flex flex-col gap-8 border-t border-rule pt-6 font-mono text-xs uppercase tracking-widest text-mute sm:flex-row sm:items-start sm:justify-between sm:gap-4">
		  <div class="flex flex-col gap-3">
			<span class="whitespace-nowrap text-[0.6rem] sm:text-xs">© {new Date().getFullYear()} Gustav Vising <span class="text-brick" aria-hidden="true">◼&#xFE0E;</span> Enskild näringsidkare</span>
			<address class="not-italic leading-relaxed text-[0.6rem] sm:text-xs lg:text-[0.68rem]">
			  Dragonvägen 7 lgh 1110<br />
			  702 54 Örebro
			</address>
			<a href="/integritet" class="underline underline-offset-4 decoration-mute/40 hover:decoration-ink self-start text-[0.6rem] transition-colors hover:text-ink sm:text-xs lg:text-[0.68rem]">Integritetspolicy</a>
		  </div>

        <span class="flex flex-wrap gap-x-6 gap-y-3 sm:gap-6">
          <a class="underline underline-offset-4 decoration-mute/40 hover:decoration-ink transition-colors hover:text-ink text-[0.6rem] sm:text-xs lg:text-[0.68rem]" href="mailto:gustav@gustavvising.se">e-post</a>
          <a class="underline underline-offset-4 decoration-mute/40 hover:decoration-ink transition-colors hover:text-ink text-[0.6rem] sm:text-xs lg:text-[0.68rem]" href="https://www.linkedin.com/in/gustavvising/" target="_blank" rel="noopener noreferrer">linkedin</a>
		  <a class="underline underline-offset-4 decoration-mute/40 hover:decoration-ink transition-colors hover:text-ink text-[0.6rem] sm:text-xs lg:text-[0.68rem]" href="https://github.com/gustavvising" target="_blank" rel="noopener noreferrer">github</a>
        </span>
      </footer>

    </article>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(ld)} />

  <script>
    const bar = document.getElementById('progress') as HTMLElement;

    const upd = () => {
      const h = document.documentElement;
      const p = h.scrollTop / Math.max(1, h.scrollHeight - h.clientHeight);
      bar.style.transform = `scaleX(${Math.min(1, Math.max(0, p))})`;
    };

    addEventListener('scroll', upd, { passive: true });
    upd();
  </script>
</Base>
