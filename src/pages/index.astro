---
import Base from '../layouts/Base.astro';
import { getPosts, postUrl, formatDate} from '../lib/posts';

const posts = await getPosts();
const penTargets = ['Webbapplikation', 'API', 'Android', 'iOS', 'Mjukvara', 'Hårdvara', 'IAM'];
const steps = [
  { title: 'Kontakt', text: 'Ni hör av er via mejl eller LinkedIn med en kort beskrivning av vad ni vill ha testat.' },
  { title: 'Strategisamtal', text: 'Vi går igenom era system, mål och risker för att hitta rätt upplägg och avgränsning.' },
  { title: 'Offert och avtal', text: 'Ni får en offert med omfattning, tidplan och pris. Allt regleras skriftligt med sekretessavtal och tillstånd för testningen.' },
  { title: 'Testning', text: 'Systemen testas manuellt inom det avtalade testfönstret. Kritiska sårbarheter rapporteras direkt när de upptäcks.' },
  { title: 'Rapport', text: 'En rapport med sammanfattning för ledningen, tekniska detaljer och åtgärdsförslag.' },
  { title: 'Genomgång och återtest', text: 'Vi går igenom resultaten tillsammans. När sårbarheterna är åtgärdade testas de igen för att bekräfta att de är stängda.' },
];
---
<Base hex>
  <main>
    <!-- HERO -->
    <section class="relative flex min-h-[60svh] flex-col justify-center px-5 pb-6 pt-20 sm:min-h-[68svh] sm:px-10 sm:pb-10 sm:pt-24">
      <div class="mx-auto w-full max-w-[88rem]">
        <h1 class="hero-title font-display font-extrabold lowercase leading-[0.86] tracking-[-0.045em]" aria-label="Gustav Vising">
          <span class="line-mask"><span data-hero-line><span class="text-green">g</span>ustav</span></span>
          <span class="line-mask"><span data-hero-line>vising</span></span>
        </h1>
        <div class="reveal mt-10 flex flex-col gap-6 border-t border-rule pt-6 sm:flex-row sm:items-end sm:justify-between">
          <p class="whitespace-nowrap text-[clamp(0.7rem,3.6vw,1.125rem)] leading-relaxed text-ink">
		    Hitta sårbarheterna, innan angriparna gör det.
		  </p>
        </div>
      </div>
    </section>

    <!-- SERVICES -->
    <section id="tjanster" class="px-5 pt-10 sm:px-10 sm:pt-20">
      <div class="mx-auto max-w-[88rem]">
        <div class="reveal mb-12 sm:mb-16">
          <h2 class="font-display text-[clamp(2.6rem,8vw,7rem)] font-extrabold lowercase leading-none tracking-[-0.04em]">tjänster</h2>
        </div>

        <div class="grid gap-4 lg:grid-cols-12">
          <!-- Penetrationstest -->
          <article class="service parallelogram-card reveal lg:col-span-6">
            <h3 class="service-title">penetrationstest</h3>
            <p class="service-text">Manuella tester där varje system gås igenom grundligt för att kartlägga hela attackytan och hitta sårbarheterna.
			Testerna utförs externt med ögonen från en angripare över internet eller internt med tillgång till ert nätverk.
			</p>
            <ul class="mt-auto flex flex-wrap gap-2 pt-8">
              {penTargets.map((t) => <li class="chip">{t}</li>)}
            </ul>
          </article>

          <!-- Säkerhetsretainer -->
          <article class="service parallelogram-card reveal lg:col-span-6">
            <h3 class="service-title">säkerhetsretainer</h3>
            <p class="service-text">
              Era tjänster förändras hela tiden och en säkerhetsbedömning blir snabbt inaktuell. Med en retainer testas systemen varje månad så att nya sårbarheter upptäcks i tid. Retainern ger också en kontinuerlig dialog kring säkerhetsarbetet, med rådgivning och utbildning av personal.
            </p>
          </article>

          <!-- Red team -->
          <article class="service parallelogram-card reveal lg:col-span-6 lg:col-start-4">
            <h3 class="service-title">red team</h3>
            <p class="service-text">Realistiska attacker mot hela organisationen, där människor är en del av försvaret. Hur ser er säkerhetskultur ut och kommer någon att nappa på ett phishing-mejl?</p>
            <ul class="mt-auto flex flex-wrap items-center gap-2 pt-8">
			  <li class="chip">Phishing</li>
			  <li class="chip">Fysisk säkerhet</li>
			</ul>
          </article>
        </div>
      </div>
    </section>

	<!-- PROCESS -->
	<section id="process" aria-label="Så går det till" class="px-5 pt-12 sm:px-10 sm:pt-16">
	  <div class="mx-auto max-w-[88rem]">

		<ol class="relative mx-auto max-w-5xl before:absolute before:inset-y-2 before:left-[6.5px] before:w-px before:bg-rule lg:before:left-1/2 lg:before:-translate-x-1/2">
		  {steps.map((step, i) => (
			<li class="reveal relative pb-14 pl-10 last:pb-0 lg:grid lg:grid-cols-2 lg:gap-20 lg:pb-0 lg:pl-0 lg:not-first:-mt-8">
			  <span class={`absolute left-0 top-1 size-3.5 rounded-full border-2 border-green lg:left-1/2 lg:-translate-x-1/2 ${i === steps.length - 1 ? 'bg-green' : 'bg-night'}`} aria-hidden="true"></span>
			  <div class={i % 2 === 0 ? 'lg:col-start-1 lg:text-right' : 'lg:col-start-2'}>
				<p class="font-mono text-xs uppercase tracking-widest text-green">Steg {i + 1}</p>
				<h3 class="mt-3 font-display text-[clamp(1.5rem,3vw,2.4rem)] font-extrabold lowercase leading-none tracking-[-0.04em]">{step.title}</h3>
				<p class="mt-4 text-sm leading-relaxed text-mute sm:text-base lg:inline-block lg:max-w-md">{step.text}</p>
			  </div>
			</li>
		  ))}
		</ol>
		<div class="reveal mt-16 flex justify-center sm:mt-20">
			<a
			  href="mailto:gustav@gustavvising.se?subject=F%C3%B6rfr%C3%A5gan%20om%20s%C3%A4kerhetstest"
			  class="inline-flex -skew-x-[5deg] items-center self-start rounded-[3px] bg-green px-7 py-3.5 font-mono text-[0.78rem] font-semibold uppercase tracking-widest text-night transition-colors hover:bg-mint sm:px-8 sm:text-sm"
			>
			  <span class="inline-block skew-x-[5deg]">Boka ett strategisamtal</span>
			</a>
	    </div>
	  </div>
	</section>

    <!-- ABOUT -->
    <section id="om-mig" class="px-5 pt-28 sm:px-10 sm:pt-40">
      <div class="mx-auto max-w-[88rem]">
        <div class="reveal mb-12 sm:mb-16">
          <h2 class="font-display text-[clamp(2.6rem,8vw,7rem)] font-extrabold lowercase leading-none tracking-[-0.04em]">om mig</h2>
        </div>
        <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,26rem)_1fr] lg:gap-20">
          <div class="reveal about-photo">
            <img src="/images/gustav.jpg" alt="Gustav Vising" width="900" height="887" loading="lazy" decoding="async" />
          </div>
          <div class="reveal">
            <div class="mt-8 max-w-xl space-y-5 text-lg leading-relaxed text-mute">
              <p>Cybersäkerhetskonsult med fokus på offensiv säkerhet. Jag hjälper företag att hitta sårbarheter i deras system, innan någon annan gör det.</p>
			  <p>Jag testar manuellt och letar efter både kända och unika sårbarheter som kan uppstå i just er tjänst. Fynden förmedlas så att både utvecklare och ledning förstår vad som är fel, hur allvarligt det är och hur det åtgärdas.</p>
              <p>
				  Du kan läsa mer om sårbarheter och säkerhet i mina{' '}
				  <a
					href="#artiklar"
					class="text-mint underline decoration-mint decoration-2 underline-offset-4 transition-colors hover:text-ink hover:decoration-ink"
				  >artiklar</a>.
				</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- WRITING -->
    <section id="artiklar" class="px-5 py-28 sm:px-10 sm:py-40">
      <div class="mx-auto max-w-[88rem]">
        <div class="reveal mb-12 flex items-baseline justify-between gap-6 sm:mb-16">
			<h2 class="font-display text-[clamp(2.6rem,8vw,7rem)] font-extrabold lowercase leading-none tracking-[-0.04em]">
				artiklar
			</h2>
		</div>
        <div class="reveal">
          {posts.map((p, i) => (
            <a class="post-row" href={postUrl(p)}>
              <h3 class="font-display text-[clamp(1.4rem,3.4vw,2.6rem)] lg:text-[clamp(1.3rem,2.8vw,2.2rem)] font-bold leading-[1.1] tracking-[-0.02em]">{p.data.title}</h3>
              <span class="meta meta-col font-mono text-[0.78rem] uppercase tracking-widest text-mute transition-colors">
                {formatDate(p.data.date)}
              </span>
            </a>
          ))}
          <div class="border-t border-rule"></div>
        </div>
      </div>
    </section>
	
		<!-- PROJECTS -->
	<section id="projekt" class="px-5 pb-24 sm:px-10 sm:pb-32">
	  <div class="mx-auto max-w-[88rem]">

		<div class="reveal mb-12 sm:mb-16">
		  <h2 class="font-display text-[clamp(2.6rem,8vw,7rem)] font-extrabold lowercase leading-none tracking-[-0.04em]">
			projekt
		  </h2>
		</div>

		<a
		  href="https://github.com/gustavvising"
		  target="_blank"
		  rel="noopener noreferrer"
		  class="parallelogram-card reveal group relative block overflow-visible p-6 sm:p-10"
		>
		  <h3 class="mt-2 font-display text-[clamp(1.4rem,5.5vw,5rem)] font-extrabold lowercase leading-[1] tracking-[-0.04em]">
			github.com<span class="text-green">/</span><br />gustavvising
		  </h3>
		</a>
		<div class="mt-4 grid gap-4 md:grid-cols-2">
		  <a
			href="https://github.com/gustavvising/ApiDehash"
			target="_blank"
			rel="noopener noreferrer"
			class="parallelogram-card reveal group relative flex flex-col overflow-visible p-6 sm:p-8"
		  >
			<h3 class="mt-4 font-display text-[clamp(1.6rem,3.5vw,2.6rem)] font-extrabold lowercase leading-[1] tracking-[-0.04em]">
			  api dehash
			</h3>

			<p class="mt-4 max-w-md text-sm text-mute sm:text-base">
			  Verktyg för analys av skadlig kod som identifierar Windows API-funktioner som döljs med API-hashing.
			</p>
		  </a>
		  <a
			  href="https://github.com/gustavvising/RemoteProcessManager"
			  target="_blank"
			  rel="noopener noreferrer"
			  class="parallelogram-card reveal group relative flex flex-col overflow-visible p-6 sm:p-8"
			>
			  <h3 class="mt-4 font-display text-[clamp(1.6rem,3.5vw,2.6rem)] font-extrabold lowercase leading-[1] tracking-[-0.04em]">
				remote process manager
			  </h3>

			  <p class="mt-4 max-w-md text-sm text-mute sm:text-base">
				Fjärrhantering av processer i Windows med en agent, en server och en webbaserad dashboard för att övervaka och hantera systemprocesser.
			  </p>
			</a>
		</div>
	  </div>
	</section>

    <!-- CONTACT -->
	<section id="kontakt" class="px-5 pb-8 sm:px-10">
	  <div class="mx-auto max-w-[88rem]">
		<h2 class="font-display text-[clamp(2.6rem,7vw,6rem)] font-extrabold lowercase leading-[0.95] tracking-[-0.04em]">
		  hör<br />av dig
		</h2>
		<p class="mt-8 max-w-md text-lg leading-relaxed text-mute">
		  Har du frågor om mina tjänster eller vill du få ett system testat? Hör av dig så tar vi det därifrån.
		</p>
		<div class="mt-6 flex flex-col items-start gap-3 text-lg">
		  <a
			href="mailto:gustav@gustavvising.se"
			class="text-mint underline decoration-mint decoration-2 underline-offset-4 transition-colors hover:text-ink hover:decoration-ink"
		  >e-post</a>
		  <a
			href="https://www.linkedin.com/in/gustavvising/"
			target="_blank"
			rel="noopener noreferrer"
			class="text-mint underline decoration-mint decoration-2 underline-offset-4 transition-colors hover:text-ink hover:decoration-ink"
		  >linkedin</a>
		</div>
	  </div>
	</section>

	<footer class="px-5 pb-10 pt-10 sm:px-10">
	  <div class="mx-auto flex max-w-[88rem] flex-col gap-3 border-t border-rule pt-6 font-mono text-xs uppercase tracking-widest text-mute">
		<span class="whitespace-nowrap text-[0.6rem] sm:text-xs">© {new Date().getFullYear()} Gustav Vising <span class="text-green" aria-hidden="true">◼&#xFE0E;</span> Enskild näringsidkare</span>
		<address class="not-italic leading-relaxed text-[0.6rem] sm:text-xs lg:text-[0.68rem]">
		  Dragonvägen 7 lgh 1110<br />
		  702 54 Örebro
		</address>
		<a href="/integritetspolicy" class="mt-3 underline underline-offset-4 decoration-mute/40 hover:decoration-ink self-start text-[0.6rem] transition-colors hover:text-ink sm:text-xs lg:text-[0.68rem]">Integritetspolicy</a>
	  </div>
	</footer>
  </main>
</Base>