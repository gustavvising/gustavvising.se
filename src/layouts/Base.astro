---
import '../styles/global.css';
import '@fontsource-variable/syne';
import '@fontsource-variable/inter';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import HexField from '../components/HexField.astro';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  lang?: string;
  published?: Date;
  image?: string;
}
const {
  title,
  description = 'Cybersäkerhetskonsult med inriktning mot offensiv säkerhet. Artiklar om reverse engineering, sårbarheter och skadlig kod.',
  type = 'website',
  lang = 'sv',
  published,
  image = '/og.png',
} = Astro.props;
const fullTitle = title ? `${title} - Gustav Vising` : 'Gustav Vising';
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, ''), Astro.site);
const ogImage = new URL(image, Astro.site);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Gustav Vising" />
    <meta name="theme-color" content="#1a0a0d" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="alternate" type="application/atom+xml" title="Gustav Vising" href="/feed.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Gustav Vising" />
    <meta property="og:title" content={title ?? 'Gustav Vising'} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
  </head>
  <body class="grain bg-night text-ink">
    <HexField />

    <header class="fixed top-0 inset-x-0 z-50 w-full bg-night">
      <div class="mx-auto flex max-w-[88rem] items-center justify-between px-5 py-5 sm:px-10">
        <a href="/" class="font-display text-lg font-extrabold lowercase tracking-tight" aria-label="Gustav Vising, startsidan">
          gv<span class="text-green">.</span>
        </a>
        <nav class="flex gap-2.5 text-[0.78rem] text-mute sm:gap-8 sm:text-[0.72rem]">
		  <a class="transition-colors hover:text-ink" href="/#tjanster">tjänster</a>
		  <a class="transition-colors hover:text-ink" href="/#om-mig">om mig</a>
		  <a class="transition-colors hover:text-ink" href="/#artiklar">artiklar</a>
		  <a class="transition-colors hover:text-ink" href="/#projekt">projekt</a>
		  <a class="transition-colors hover:text-ink" href="/#kontakt">kontakt</a>
        </nav>
      </div>
    </header>

    <div class="relative z-10">
      <slot />
    </div>
  </body>
</html>
